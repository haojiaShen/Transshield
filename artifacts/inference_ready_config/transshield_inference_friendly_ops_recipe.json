{
  "purpose": "Recommended ViT-side configuration before running the OpenBumbleBee integration path.",
  "status": "code_ready_not_retrained",
  "recommended_args": {
    "use_square_gelu": true,
    "square_activation_mode": "learnable_quadratic_gelu_init",
    "use_approx_attn": true,
    "approx_attn_mode": "relu",
    "use_mask_pruning": true,
    "eval_pruning_mode": "compare_network_tie",
    "eval_tie_policy": "lowest_index"
  },
  "convenience_arg": {
    "inference_friendly_ops": true,
    "effect": "Enables square-family activations, approximate attention, mask pruning, and compare-network/tie eval pruning."
  },
  "operator_mapping": {
    "activation": {
      "replacement": "GELU -> square/quadratic activation family",
      "core_location": "models/dyvit.py::get_act_layer"
    },
    "attention": {
      "replacement": "softmax attention -> normalized approximate attention without exp",
      "core_location": "models/dyvit.py::Attention._approx_attention",
      "supported_modes": [
        "relu",
        "relu_square",
        "square_relu",
        "abs_square"
      ]
    },
    "dynamic_pruning": {
      "replacement": "eval argsort/scatter top-k -> compare-network kth threshold plus F_less-style comparison and deterministic tie policy",
      "core_location": "models/dyvit.py::VisionTransformerDiffPruning._build_eval_keep_decision",
      "supported_modes": [
        "topk_argsort",
        "compare_network_tie",
        "f_less_tie"
      ]
    },
    "mask_application": {
      "replacement": "token * binary mask as F_mux(mask, token, zero)",
      "core_location": "models/dyvit.py::VisionTransformerDiffPruning._apply_spatial_mask"
    }
  },
  "compatibility": {
    "default_behavior_preserves_existing_frozen_baseline": true,
    "frozen_bundle_args_snapshot_still_has_use_approx_attn_false": true,
    "needs_retraining_or_finetuning_for_final_accuracy_claim": true,
    "bumblebee_execution_required_later": false
  }
}
